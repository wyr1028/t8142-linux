/*
 * ============ 以下条目**未**写出,偏移与其他条目重复 ============
 *
 * 偏移重复说明绝对地址还缺一个基址。定出基址之前不要动这些。
 * 格式: 偏移  设备号  名字
 *
 *  0x00000  id=331   ANE-SYS-V
 *  0x00000  id=522   ANE-SYS-V-PMP
 *  0x00000  id=337   ANS-V
 *  0x00000  id=338   APCIE-GP-V
 *  0x00000  id=340   APCIE-ST-V
 *  0x00000  id=339   APCIE-SYS-GP-V
 *  0x00000  id=341   APCIE-SYS-ST-V
 *  0x00000  id=347   ATC0-COMMON-V
 *  0x00000  id=321   ATC0-USB-AUD-V
 *  0x00000  id=325   ATC0-USB-DART
 *  0x00000  id=343   ATC0-USB-V
 *  0x00000  id=357   ATC0_PCIE-V
 *  0x00000  id=348   ATC1-COMMON-V
 *  0x00000  id=322   ATC1-USB-AUD-V
 *  0x00000  id=326   ATC1-USB-DART
 *  0x00000  id=344   ATC1-USB-V
 *  0x00000  id=358   ATC1_PCIE-V
 *  0x00000  id=349   ATC2-COMMON-V
 *  0x00000  id=323   ATC2-USB-AUD-V
 *  0x00000  id=327   ATC2-USB-DART
 *  0x00000  id=345   ATC2-USB-V
 *  0x00000  id=359   ATC2_PCIE-V
 *  0x00000  id=350   ATC3-COMMON-V
 *  0x00000  id=324   ATC3-USB-AUD-V
 *  0x00000  id=328   ATC3-USB-DART
 *  0x00000  id=346   ATC3-USB-V
 *  0x00000  id=360   ATC3_PCIE-V
 *  0x00000  id=356   AUDIO-LLT-V
 *  0x00000  id=316   AUSB0_AONPCIE-V
 *  0x00000  id=312   AUSB0_AONUSB-V
 *  0x00000  id=317   AUSB1_AONPCIE-V
 *  0x00000  id=313   AUSB1_AONUSB-V
 *  0x00000  id=318   AUSB2_AONPCIE-V
